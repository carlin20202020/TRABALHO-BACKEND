# ============================================================
# SGOA - variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA envie o arquivo .env para o GitHub (já está no .gitignore).
# ============================================================

# Porta em que a API vai rodar
PORT=3000

# Supabase -> Project Settings > API Keys / botão "Connect"
SUPABASE_URL=https://bojsbpilonfymvzpuxrk.supabase.co
# Chave SECRETA (sb_secret_...) ou a legada "service_role". Só no backend!
SUPABASE_SECRET_KEY=

# Nome do bucket do Storage onde ficam as fotos (criado pelo schema.sql)
SUPABASE_BUCKET=ocorrencias

# Segredo usado para assinar os tokens JWT (use um texto longo e aleatório)
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Padrão da matrícula estadual (CGM/RA), em expressão regular.
# Padrão do projeto: 8 a 10 dígitos numéricos. CONFIRME com o professor e ajuste se preciso.
MATRICULA_REGEX=^\d{8,10}$
