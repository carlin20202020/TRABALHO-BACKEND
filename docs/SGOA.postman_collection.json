                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "titulo",
                  "value": "Monitor quebrado",
                  "type": "text"
                },
                {
                  "key": "descricao",
                  "value": "A tela não liga mais",
                  "type": "text"
                },
                {
                  "key": "categoria",
                  "value": "Hardware Quebrado",
                  "type": "text"
                },
                {
                  "key": "equipamento_id",
                  "value": "{{equipamentoId}}",
                  "type": "text"
                },
