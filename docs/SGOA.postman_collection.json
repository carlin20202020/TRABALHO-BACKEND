            },
            "url": "{{baseUrl}}/equipamentos"
          }
        },
        {
          "name": "Listar equipamentos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/equipamentos"
          }
        },
        {
          "name": "[Admin] Editar equipamento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Em Manutenção\"\n}"
            },
            "url": "{{baseUrl}}/equipamentos/{{equipamentoId}}"
          }
        },
        {
          "name": "[Admin] Excluir equipamento",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/equipamentos/{{equipamentoId}}"
          }
        },
        {
          "name": "[Admin] Excluir sala",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/salas/{{salaId}}"
          }
        }
      ]
    },
    {
      "name": "3. Ocorrências",
      "item": [
        {
          "name": "Aluno tenta abrir chamado (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
