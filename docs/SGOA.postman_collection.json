            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Sem internet\",\n  \"descricao\": \"A rede caiu no laboratório\",\n  \"categoria\": \"Sem Internet\",\n  \"equipamento_id\": \"{{equipamentoId}}\"\n}"
            },
            "url": "{{baseUrl}}/ocorrencias"
          }
        },
        {
          "name": "Listar ocorrências (aluno: ativas | professor: as suas | admin: todas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ocorrencias"
          }
        },
