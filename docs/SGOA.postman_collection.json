        {
          "name": "[Professor] Abrir \"Sem Internet\" (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.ocorrencia && j.ocorrencia.id) pm.collectionVariables.set('ocorrenciaId', j.ocorrencia && j.ocorrencia.id);"
