{
  "info": {
    "name": "SGOA - API de Ocorrências Escolares",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "salaId",
      "value": ""
    },
    {
      "key": "equipamentoId",
      "value": ""
    },
    {
      "key": "ocorrenciaId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Login (guarda o token sozinho)",
      "item": [
        {
          "name": "Login - Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@escola.pr.gov.br\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login - Professor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"professor@escola.pr.gov.br\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login - Aluno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aluno@escola.pr.gov.br\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Quem sou eu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "1. Cadastro e usuários",
      "item": [
        {
          "name": "Registro público - Aluno (matrícula válida)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Carlos Pereira\",\n  \"email\": \"carlos@aluno.com\",\n  \"senha\": \"Senha@123\",\n  \"matricula\": \"123456789\",\n  \"perfil\": \"Aluno\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/registro"
          }
        },
        {
          "name": "Registro - matrícula INVÁLIDA (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Carlos Pereira\",\n  \"email\": \"carlos2@aluno.com\",\n  \"senha\": \"Senha@123\",\n  \"matricula\": \"12ab\",\n  \"perfil\": \"Aluno\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/registro"
          }
        },
        {
          "name": "Registro como Administrador (403 - só existe 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Outro Admin\",\n  \"email\": \"outro@admin.com\",\n  \"senha\": \"Senha@123\",\n  \"matricula\": \"987654321\",\n  \"perfil\": \"Administrador\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/registro"
          }
        },
        {
          "name": "[Admin] Criar professor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.usuario && j.usuario.id) pm.collectionVariables.set('usuarioId', j.usuario && j.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nova Professora\",\n  \"email\": \"nova@escola.pr.gov.br\",\n  \"senha\": \"Senha@123\",\n  \"matricula\": \"555555555\",\n  \"perfil\": \"Professor\"\n}"
            },
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "[Admin] Listar contas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "[Admin] Editar usuário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nome Atualizado\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "[Admin] Redefinir senha (gera senha temporária)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}/redefinir-senha"
          }
        },
        {
          "name": "[Admin] Excluir usuário",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        }
      ]
    },
    {
      "name": "2. Salas e equipamentos (só Admin altera)",
      "item": [
        {
          "name": "[Admin] Criar sala",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.sala && j.sala.id) pm.collectionVariables.set('salaId', j.sala && j.sala.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Laboratório de Informática 3\",\n  \"descricao\": \"Novo laboratório\"\n}"
            },
            "url": "{{baseUrl}}/salas"
          }
        },
        {
          "name": "Listar salas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/salas"
          }
        },
        {
          "name": "[Admin] Renomear sala",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Laboratório de Informática 3B\"\n}"
            },
            "url": "{{baseUrl}}/salas/{{salaId}}"
          }
        },
        {
          "name": "[Admin] Criar equipamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
