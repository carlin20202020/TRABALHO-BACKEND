                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Computador 10\",\n  \"tipo\": \"Computador\",\n  \"numero_patrimonio\": \"200010\",\n  \"sala_id\": \"{{salaId}}\"\n}"
            },
            "url": "{{baseUrl}}/equipamentos"
          }
        },
        {
          "name": "Criar equipamento como Professor/Aluno (403)",
          "request": {
            "method": "POST",
